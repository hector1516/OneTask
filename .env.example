# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_please
MYSQL_DATABASE=onetask
MYSQL_USER=onetask
MYSQL_PASSWORD=change_me_onetask_please

# --- API ---
DB_HOST=mysql
DB_PORT=3306
# DB_* default to MYSQL_* when empty; compose already maps them.
# (api/entrypoint resolves DB_USER/DB_PASSWORD with fallback to MYSQL_USER/MYSQL_PASSWORD)
API_PORT=3000
JWT_SECRET=change_me_jwt_access_min_32_chars_please
JWT_REFRESH_SECRET=change_me_jwt_refresh_min_32_chars_please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated. Must include the Agent CSP origin.
CORS_ORIGINS=https://api.onetask.internal,https://onetask.ecc-sa.com.mx,http://localhost:5173,http://localhost:3000
# Devices with no heartbeat for this many seconds are reported offline.
ONLINE_THRESHOLD_SEC=300
# Seed admin (created on first boot if users table is empty).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
# Seed demo device id (registered on boot if missing).
SEED_DEVICE_ID=agent-dev-01
SEED_DEVICE_NAME=Dev Agent (Tauri)

# --- Module signing (Ed25519) ---
# Private key for manifest signing. NEVER commit the real value.
# Accepted formats (server auto-detects):
#   1) base64 of 32-byte seed,  2) hex of 32-byte seed,
#   3) base64 of PKCS8 DER private key, 4) 'generate' (ephemeral, dev only).
# Generate one with: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
MODULE_SIGNING_PRIVATE_KEY=generate

# --- Admin (build-time) ---
# Vacío = mismo origen: nginx del admin proxya /api, /auth y /health al API.
# Solo pon una URL absoluta (p. ej. http://192.168.1.66:3000) si sirves el
# Admin fuera de Docker o sin el proxy.
VITE_API_URL=
# Agent-side variable (Tauri, already used in OneTaskAgent). Kept here for parity:
# VITE_ONETASK_API_BASE_URL=http://localhost:3000
ADMIN_PORT=5173

# --- Optional tools profile ---
PHPMYADMIN_PORT=8080
